# Browser-safe (optional if all traffic goes through /api/activity-notes)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only alternatives (work on Vercel without NEXT_PUBLIC_ vars)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...

# Required for saving activities and Activity Report/MOM photos. Never prefix with NEXT_PUBLIC_.
# Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=
